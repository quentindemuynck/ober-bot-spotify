# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for fast guild-scoped command registration during development.
# Leave unset for global command registration (can take up to ~1 hour to propagate).
DISCORD_GUILD_ID=

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be a loopback IP literal (127.0.0.1), not "localhost" — Spotify requirement.
# Must exactly match the redirect URI registered in the Spotify Dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# AI provider (Gemini free tier by default — get a key with no credit card at
# https://aistudio.google.com/apikey). Any OpenAI-compatible provider works if you
# override AI_BASE_URL/AI_MODEL (e.g. OpenAI, Groq).
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Path to the SQLite database file (created automatically if missing)
DATABASE_PATH=./data/oberbot.sqlite3

# Self-imposed cap on Spotify search calls per rolling 24h. Kept below Spotify's real,
# undocumented Development Mode quota (community reports suggest ~200/24h before a full 24h
# lockout) so the bot fails fast with a clear message instead of risking that lockout again.
# Raise with care — less margin below ~200 means more risk if that estimate is off.
SEARCH_DAILY_BUDGET=180
